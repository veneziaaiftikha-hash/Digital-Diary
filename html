<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Life Book 📖</title>

<style>
/* =========================================================
   MY LIFE BOOK
   ========================================================= */

:root{
    --bg:#f4efe7;
    --paper:#fffdf7;
    --paper2:#faf5eb;
    --text:#3f3a35;
    --muted:#8d847a;
    --accent:#8b6f5a;
    --accent2:#d9c4ad;
    --border:#ded3c6;
    --shadow:0 15px 45px rgba(65,50,35,.15);
    --radius:18px;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Georgia,"Times New Roman",serif;
    background:
        radial-gradient(circle at 20% 20%,rgba(255,255,255,.7),transparent 30%),
        var(--bg);
    color:var(--text);
    min-height:100vh;
}

button,
input,
textarea,
select{
    font:inherit;
}

button{
    cursor:pointer;
}

.hidden{
    display:none!important;
}

/* =========================================================
   BOOK INTRO
   ========================================================= */

.book-intro{
    position:fixed;
    inset:0;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#e9dfd2;
    perspective:1500px;
    transition:opacity .8s,visibility .8s;
}

.book-intro.hide{
    opacity:0;
    visibility:hidden;
}

.book-cover{
    width:min(420px,85vw);
    height:min(560px,78vh);
    border-radius:8px 18px 18px 8px;
    background:
        linear-gradient(135deg,
        rgba(255,255,255,.16),
        transparent 40%),
        var(--accent);
    color:white;
    box-shadow:
        20px 25px 50px rgba(0,0,0,.28),
        inset -10px 0 rgba(0,0,0,.08);
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    transform:rotateY(-8deg);
    position:relative;
    overflow:hidden;
}

.book-cover:before{
    content:"";
    position:absolute;
    inset:18px;
    border:2px solid rgba(255,255,255,.55);
    border-radius:5px 12px 12px 5px;
}

.book-cover small{
    letter-spacing:5px;
    opacity:.8;
}

.book-cover h1{
    font-size:clamp(42px,8vw,72px);
    margin:20px 0 8px;
    font-weight:normal;
}

.book-cover p{
    font-style:italic;
    opacity:.85;
}

.open-book-btn{
    margin-top:50px;
    border:1px solid rgba(255,255,255,.6);
    background:rgba(255,255,255,.13);
    color:white;
    padding:13px 28px;
    border-radius:30px;
    transition:.25s;
}

.open-book-btn:hover{
    background:white;
    color:var(--accent);
}

/* =========================================================
   APP
   ========================================================= */

.app{
    min-height:100vh;
    display:none;
}

.app.show{
    display:block;
}

.topbar{
    height:70px;
    padding:0 25px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(255,253,247,.86);
    backdrop-filter:blur(15px);
    border-bottom:1px solid var(--border);
    position:sticky;
    top:0;
    z-index:100;
}

.brand{
    font-size:22px;
    font-weight:bold;
}

.brand span{
    font-size:13px;
    color:var(--muted);
    display:block;
    font-weight:normal;
}

.menu-btn{
    border:0;
    background:transparent;
    font-size:25px;
}

.layout{
    display:flex;
    min-height:calc(100vh - 70px);
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar{
    width:235px;
    padding:20px 15px;
    border-right:1px solid var(--border);
    background:rgba(255,253,247,.65);
    transition:.3s;
}

.nav-item{
    width:100%;
    display:flex;
    gap:12px;
    align-items:center;
    padding:12px 14px;
    margin-bottom:5px;
    border:0;
    border-radius:12px;
    background:transparent;
    color:var(--text);
    text-align:left;
}

.nav-item:hover,
.nav-item.active{
    background:var(--accent2);
}

.content{
    flex:1;
    padding:30px;
    max-width:1400px;
    margin:auto;
    width:100%;
}

.page{
    display:none;
    animation:fadeIn .4s ease;
}

.page.active{
    display:block;
}

@keyframes fadeIn{
    from{
        opacity:0;
        transform:translateY(8px);
    }
    to{
        opacity:1;
        transform:none;
    }
}

.page-heading{
    margin-bottom:25px;
}

.page-heading h2{
    font-size:32px;
    font-weight:normal;
}

.page-heading p{
    color:var(--muted);
    margin-top:5px;
}

/* =========================================================
   CARDS
   ========================================================= */

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:18px;
}

.card{
    background:var(--paper);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:20px;
    box-shadow:var(--shadow);
}

.card h3{
    margin-bottom:10px;
}

.stat{
    font-size:34px;
    margin:10px 0;
}

.muted{
    color:var(--muted);
}

/* =========================================================
   BUTTONS
   ========================================================= */

.primary{
    border:0;
    background:var(--accent);
    color:white;
    padding:11px 18px;
    border-radius:12px;
}

.secondary{
    border:1px solid var(--border);
    background:var(--paper);
    color:var(--text);
    padding:10px 15px;
    border-radius:12px;
}

.danger{
    border:0;
    background:#c87878;
    color:white;
    padding:9px 13px;
    border-radius:10px;
}

.toolbar{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:20px;
}

/* =========================================================
   FORM
   ========================================================= */

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;
    margin-bottom:6px;
    font-size:14px;
}

input,
textarea,
select{
    width:100%;
    padding:11px 12px;
    border:1px solid var(--border);
    background:var(--paper);
    color:var(--text);
    border-radius:10px;
    outline:none;
}

textarea{
    min-height:180px;
    resize:vertical;
}

input:focus,
textarea:focus,
select:focus{
    border-color:var(--accent);
}

/* =========================================================
   DIARY BOOK
   ========================================================= */

.diary-book{
    max-width:1000px;
    margin:auto;
    perspective:1800px;
}

.diary-spread{
    min-height:590px;
    display:grid;
    grid-template-columns:1fr 1fr;
    background:var(--paper);
    box-shadow:var(--shadow);
    border-radius:8px;
    overflow:hidden;
    position:relative;
}

.diary-page{
    padding:45px;
    background:
        repeating-linear-gradient(
            to bottom,
            transparent 0,
            transparent 31px,
            rgba(130,110,90,.12) 32px
        ),
        var(--paper);
    position:relative;
}

.diary-page.left{
    border-right:1px solid var(--border);
}

.page-number{
    position:absolute;
    bottom:15px;
    left:50%;
    transform:translateX(-50%);
    color:var(--muted);
    font-size:12px;
}

.diary-date{
    color:var(--accent);
    font-size:14px;
    margin-bottom:15px;
}

.diary-title{
    font-size:31px;
    margin-bottom:20px;
    font-weight:normal;
}

.diary-writing{
    white-space:pre-wrap;
    line-height:32px;
}

.page-turn-next{
    animation:turnNext .65s ease;
}

.page-turn-prev{
    animation:turnPrev .65s ease;
}

@keyframes turnNext{
    0%{
        transform:rotateY(0);
        transform-origin:left;
    }
    50%{
        transform:rotateY(-12deg);
    }
    100%{
        transform:rotateY(0);
    }
}

@keyframes turnPrev{
    0%{
        transform:rotateY(0);
        transform-origin:right;
    }
    50%{
        transform:rotateY(12deg);
    }
    100%{
        transform:rotateY(0);
    }
}

/* =========================================================
   MEMORY
   ========================================================= */

.memory-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
    gap:20px;
}

.memory-card{
    background:var(--paper);
    border:1px solid var(--border);
    border-radius:15px;
    overflow:hidden;
    box-shadow:var(--shadow);
}

.memory-card img{
    width:100%;
    height:190px;
    object-fit:cover;
    display:block;
}

.memory-info{
    padding:14px;
}

.memory-info h3{
    margin-bottom:5px;
}

.memory-info p{
    color:var(--muted);
    font-size:13px;
}

/* =========================================================
   CALENDAR
   ========================================================= */

.calendar{
    background:var(--paper);
    border:1px solid var(--border);
    border-radius:20px;
    padding:20px;
    box-shadow:var(--shadow);
}

.calendar-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.calendar-head h3{
    font-size:25px;
    font-weight:normal;
}

.calendar-week,
.calendar-days{
    display:grid;
    grid-template-columns:repeat(7,1fr);
}

.calendar-week div{
    text-align:center;
    color:var(--muted);
    font-size:13px;
    padding:10px 0;
}

.day{
    min-height:75px;
    border:1px solid rgba(180,160,140,.2);
    padding:8px;
    position:relative;
    cursor:pointer;
    transition:.2s;
}

.day:hover{
    background:var(--paper2);
}

.day.today{
    background:var(--accent2);
    font-weight:bold;
}

.day.empty{
    background:rgba(0,0,0,.015);
    cursor:default;
}

.day-dot{
    width:6px;
    height:6px;
    background:var(--accent);
    border-radius:50%;
    position:absolute;
    bottom:8px;
    left:50%;
}

/* =========================================================
   SCHEDULE
   ========================================================= */

.event{
    padding:15px;
    border-left:4px solid var(--accent);
    background:var(--paper);
    border-radius:10px;
    margin-bottom:10px;
    border-top:1px solid var(--border);
    border-right:1px solid var(--border);
    border-bottom:1px solid var(--border);
}

.event-row{
    display:flex;
    justify-content:space-between;
    gap:15px;
}

.event-time{
    font-size:14px;
    color:var(--accent);
}

/* =========================================================
   COLLAGE
   ========================================================= */

.collage-layout{
    display:grid;
    grid-template-columns:250px 1fr 250px;
    gap:15px;
}

.tool-panel{
    background:var(--paper);
    border:1px solid var(--border);
    border-radius:16px;
    padding:15px;
    box-shadow:var(--shadow);
    height:max-content;
}

.tool-panel h3{
    margin-bottom:13px;
}

.tool-btn{
    width:100%;
    border:1px solid var(--border);
    background:var(--paper2);
    padding:10px;
    border-radius:10px;
    margin-bottom:7px;
    text-align:left;
}

.tool-btn:hover{
    background:var(--accent2);
}

.template-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:7px;
}

.template-btn{
    padding:10px 5px;
    border:1px solid var(--border);
    background:var(--paper2);
    border-radius:8px;
}

.emoji-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:5px;
}

.emoji-btn{
    border:1px solid var(--border);
    background:var(--paper2);
    border-radius:8px;
    padding:6px;
    font-size:21px;
}

.canvas-wrap{
    background:#dcd3c7;
    border-radius:18px;
    padding:25px;
    min-height:650px;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:auto;
}

#collageCanvas{
    width:600px;
    height:600px;
    max-width:100%;
    position:relative;
    overflow:hidden;
    background:#fffaf0;
    box-shadow:0 15px 40px rgba(0,0,0,.2);
    background-size:cover;
}

.collage-object{
    position:absolute;
    user-select:none;
    touch-action:none;
    cursor:move;
}

.collage-photo{
    width:160px;
    height:160px;
    object-fit:cover;
    border:7px solid white;
    box-shadow:0 5px 15px rgba(0,0,0,.2);
}

.polaroid{
    background:white;
    padding:8px 8px 35px;
    border:0;
}

.collage-text{
    padding:5px;
    font-size:27px;
    font-weight:bold;
    white-space:nowrap;
}

.collage-sticker{
    font-size:42px;
}

.selected-object{
    outline:2px dashed var(--accent);
    outline-offset:4px;
}

.control-row{
    display:flex;
    gap:6px;
    margin-top:8px;
}

.control-row button{
    flex:1;
    padding:8px;
    border:1px solid var(--border);
    background:var(--paper2);
    border-radius:8px;
}

/* =========================================================
   MODAL
   ========================================================= */

.modal{
    position:fixed;
    inset:0;
    background:rgba(40,30,20,.55);
    z-index:500;
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.show{
    display:flex;
}

.modal-box{
    width:min(600px,100%);
    max-height:90vh;
    overflow:auto;
    background:var(--paper);
    border-radius:20px;
    padding:25px;
    box-shadow:0 30px 80px rgba(0,0,0,.3);
}

.modal-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.close{
    border:0;
    background:transparent;
    font-size:30px;
}

/* =========================================================
   THEME
   ========================================================= */

.theme-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}

.theme-card{
    min-height:100px;
    border:2px solid var(--border);
    border-radius:15px;
    padding:15px;
    cursor:pointer;
}

.theme-card:hover{
    transform:translateY(-2px);
}

/* =========================================================
   TOAST
   ========================================================= */

.toast{
    position:fixed;
    right:25px;
    bottom:25px;
    background:var(--text);
    color:white;
    padding:13px 18px;
    border-radius:12px;
    opacity:0;
    transform:translateY(15px);
    transition:.3s;
    z-index:9999;
    pointer-events:none;
}

.toast.show{
    opacity:1;
    transform:none;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:1000px){

    .collage-layout{
        grid-template-columns:1fr;
    }

    .tool-panel{
        width:100%;
    }

    .diary-spread{
        grid-template-columns:1fr;
    }

    .diary-page.left{
        border-right:0;
        border-bottom:1px solid var(--border);
    }

}

@media(max-width:700px){

    .sidebar{
        position:fixed;
        left:-250px;
        top:70px;
        bottom:0;
        z-index:200;
    }

    .sidebar.open{
        left:0;
    }

    .content{
        padding:20px 12px;
    }

    .topbar{
        padding:0 15px;
    }

    .calendar{
        overflow:auto;
    }

    .day{
        min-height:55px;
        font-size:12px;
    }

    .diary-page{
        padding:28px;
    }

    #collageCanvas{
        width:500px;
        height:500px;
    }

}
</style>
</head>

<body>

<!-- =======================================================
     BOOK COVER
======================================================= -->

<div class="book-intro" id="bookIntro">

    <div class="book-cover">

        <small>MY PERSONAL JOURNAL</small>

        <h1>My<br>Life Book</h1>

        <p>little moments, big memories ✦</p>

        <button class="open-book-btn"
                onclick="openBook()">
            Open My Book 📖
        </button>

    </div>

</div>


<!-- =======================================================
     APP
======================================================= -->

<div class="app" id="app">

<header class="topbar">

    <button class="menu-btn"
            onclick="toggleSidebar()">
        ☰
    </button>

    <div class="brand">
        My Life Book
        <span>your little corner of life</span>
    </div>

    <div>
        <button class="secondary"
                onclick="showPage('settings')">
            ⚙️
        </button>
    </div>

</header>


<div class="layout">

<!-- =======================================================
     SIDEBAR
======================================================= -->

<aside class="sidebar" id="sidebar">

    <button class="nav-item active"
            data-page="home"
            onclick="showPage('home')">
        🏠 Home
    </button>

    <button class="nav-item"
            data-page="diary"
            onclick="showPage('diary')">
        📖 Diary
    </button>

    <button class="nav-item"
            data-page="schedule"
            onclick="showPage('schedule')">
        📅 Schedule
    </button>

    <button class="nav-item"
            data-page="tasks"
            onclick="showPage('tasks')">
        ✅ Tasks
    </button>

    <button class="nav-item"
            data-page="memories"
            onclick="showPage('memories')">
        📸 Memories
    </button>

    <button class="nav-item"
            data-page="calendar"
            onclick="showPage('calendar')">
        🗓️ Calendar
    </button>

    <button class="nav-item"
            data-page="collage"
            onclick="showPage('collage')">
        🎨 Collage Maker
    </button>

    <button class="nav-item"
            data-page="settings"
            onclick="showPage('settings')">
        🎨 Themes
    </button>

</aside>


<!-- =======================================================
     CONTENT
======================================================= -->

<main class="content">

<!-- HOME -->

<section class="page active" id="home">

    <div class="page-heading">

        <h2>Good day, storyteller ✦</h2>

        <p id="homeDate"></p>

    </div>


    <div class="grid">

        <div class="card">

            <h3>📖 Diary Entries</h3>

            <div class="stat"
                 id="diaryCount">
                0
            </div>

            <p class="muted">
                little stories you've written
            </p>

        </div>


        <div class="card">

            <h3>📸 Memories</h3>

            <div class="stat"
                 id="memoryCount">
                0
            </div>

            <p class="muted">
                moments worth keeping
            </p>

        </div>


        <div class="card">

            <h3>✅ Tasks</h3>

            <div class="stat"
                 id="taskCount">
                0
            </div>

            <p class="muted">
                things on your list
            </p>

        </div>


        <div class="card">

            <h3>⏰ Next Up</h3>

            <div id="nextEvent">
                No upcoming schedule.
            </div>

        </div>

    </div>


    <br>


    <div class="card">

        <h3>💭 Today's Thought</h3>

        <br>

        <textarea id="quickThought"
                  placeholder="Write something you're thinking about..."></textarea>

        <br><br>

        <button class="primary"
                onclick="saveQuickThought()">
            Save Thought
        </button>

    </div>

</section>


<!-- =======================================================
     DIARY
======================================================= -->

<section class="page" id="diary">

    <div class="page-heading">

        <h2>📖 My Diary</h2>

        <p>Turn the pages and keep your stories here.</p>

    </div>


    <div class="toolbar">

        <button class="primary"
                onclick="newDiary()">
            + New Entry
        </button>

        <button class="secondary"
                onclick="previousDiary()">
            ← Previous
        </button>

        <button class="secondary"
                onclick="nextDiary()">
            Next →
        </button>

    </div>


    <div class="diary-book">

        <div class="diary-spread"
             id="diarySpread">

            <div class="diary-page left">

                <div class="diary-date"
                     id="diaryDate">
                    —
                </div>

                <h2 class="diary-title"
                    id="diaryTitle">
                    Welcome
                </h2>

                <div class="diary-writing"
                     id="diaryText">
                    Your diary pages will appear here.
                </div>

                <div class="page-number">
                    <span id="leftPage">1</span>
                </div>

            </div>


            <div class="diary-page">

                <h3>✦ Today's Mood</h3>

                <br>

                <div id="diaryMood"
                     style="font-size:45px">
                    ☁️
                </div>

                <br>

                <p class="muted">
                    Every day doesn't have to be perfect.
                    It only needs a page.
                </p>

                <br><br>

                <button class="secondary"
                        onclick="editCurrentDiary()">
                    ✏️ Edit Page
                </button>

                <button class="danger"
                        onclick="deleteCurrentDiary()">
                    Delete
                </button>

                <div class="page-number">
                    <span id="rightPage">2</span>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =======================================================
     SCHEDULE
======================================================= -->

<section class="page" id="schedule">

    <div class="page-heading">

        <h2>📅 Schedule</h2>

        <p>Keep track of the things you need to do.</p>

    </div>


    <div class="toolbar">

        <button class="primary"
                onclick="openEventModal()">
            + Add Event
        </button>

        <button class="secondary"
                onclick="enableNotifications()">
            🔔 Enable Notifications
        </button>

    </div>


    <div id="eventList"></div>

</section>


<!-- =======================================================
     TASKS
======================================================= -->

<section class="page" id="tasks">

    <div class="page-heading">

        <h2>✅ Tasks</h2>

        <p>Small steps still count.</p>

    </div>


    <div class="toolbar">

        <input id="taskInput"
               placeholder="Add a task..."
               style="max-width:400px">

        <button class="primary"
                onclick="addTask()">
            Add
        </button>

    </div>


    <div id="taskList"></div>

</section>


<!-- =======================================================
     MEMORIES
======================================================= -->

<section class="page" id="memories">

    <div class="page-heading">

