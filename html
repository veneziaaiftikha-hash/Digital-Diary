<script>
/* =========================================================
   DATA
========================================================= */

let diaries =
    JSON.parse(localStorage.getItem("mlb_diaries")) || [];

let events =
    JSON.parse(localStorage.getItem("mlb_events")) || [];

let tasks =
    JSON.parse(localStorage.getItem("mlb_tasks")) || [];

let memories =
    JSON.parse(localStorage.getItem("mlb_memories")) || [];

let quickThought =
    localStorage.getItem("mlb_thought") || "";

let currentDiaryIndex = 0;

let calendarDate = new Date();

let selectedObject = null;

let collageObjects = [];

let notifiedEvents =
    JSON.parse(localStorage.getItem("mlb_notified")) || [];


/* =========================================================
   HELPERS
========================================================= */

function saveAll(){

    localStorage.setItem(
        "mlb_diaries",
        JSON.stringify(diaries)
    );

    localStorage.setItem(
        "mlb_events",
        JSON.stringify(events)
    );

    localStorage.setItem(
        "mlb_tasks",
        JSON.stringify(tasks)
    );

    localStorage.setItem(
        "mlb_memories",
        JSON.stringify(memories)
    );

}


function todayISO(){

    return new Date()
        .toISOString()
        .split("T")[0];

}


function formatDate(date){

    if(!date) return "";

    return new Date(date+"T00:00:00")
        .toLocaleDateString(
            "en-US",
            {
                day:"numeric",
                month:"long",
                year:"numeric"
            }
        );

}


function escapeHTML(str){

    return String(str || "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function showToast(message){

    const toast=
        document.getElementById("toast");

    toast.textContent=message;

    toast.classList.add("show");

    setTimeout(()=>{
        toast.classList.remove("show");
    },2800);

}


function closeModal(id){

    document
        .getElementById(id)
        .classList.remove("show");

}


/* =========================================================
   BOOK OPEN
========================================================= */

function openBook(){

    document
        .getElementById("bookIntro")
        .classList.add("hide");

    document
        .getElementById("app")
        .classList.add("show");

    renderAll();

}


/* =========================================================
   NAVIGATION
========================================================= */

function toggleSidebar(){

    document
        .getElementById("sidebar")
        .classList.toggle("open");

}


function showPage(page){

    document
        .querySelectorAll(".page")
        .forEach(p=>{
            p.classList.remove("active");
        });

    document
        .getElementById(page)
        .classList.add("active");


    document
        .querySelectorAll(".nav-item")
        .forEach(btn=>{
            btn.classList.toggle(
                "active",
                btn.dataset.page===page
            );
        });


    document
        .getElementById("sidebar")
        .classList.remove("open");


    if(page==="calendar")
        renderCalendar();

    if(page==="collage")
        renderCollage();

}


/* =========================================================
   HOME
========================================================= */

function renderHome(){

    document.getElementById("homeDate")
        .textContent=
        new Date().toLocaleDateString(
            "en-US",
            {
                weekday:"long",
                day:"numeric",
                month:"long",
                year:"numeric"
            }
        );


    document.getElementById("diaryCount")
        .textContent=diaries.length;

    document.getElementById("memoryCount")
        .textContent=memories.length;

    document.getElementById("taskCount")
        .textContent=
        tasks.filter(t=>!t.done).length;


    document.getElementById("quickThought")
        .value=quickThought;


    renderNextEvent();

}


function saveQuickThought(){

    quickThought=
        document.getElementById("quickThought")
        .value;

    localStorage.setItem(
        "mlb_thought",
        quickThought
    );

    showToast("Thought saved ✦");

}


function renderNextEvent(){

    const now=new Date();

    const upcoming=events
        .map(e=>({
            ...e,
            dateTime:new Date(
                e.date+"T"+e.time
            )
        }))
        .filter(e=>e.dateTime>now)
        .sort((a,b)=>
            a.dateTime-b.dateTime
        );


    const box=
        document.getElementById("nextEvent");


    if(!upcoming.length){

        box.innerHTML=
            `<p class="muted">
                No upcoming schedule.
            </p>`;

        return;

    }


    const e=upcoming[0];

    const diff=e.dateTime-now;

    const mins=
        Math.floor(diff/60000);

    let countdown;

    if(mins<60)
        countdown=`in ${mins} min`;

    else{

        const h=Math.floor(mins/60);

        const m=mins%60;

        countdown=
            `in ${h}h ${m}m`;

    }


    box.innerHTML=`

        <h3>
            ${escapeHTML(e.title)}
        </h3>

        <p class="event-time">
            ${e.date} • ${e.time}
        </p>

        <br>

        <strong>
            ⏰ ${countdown}
        </strong>

    `;

}


/* =========================================================
   DIARY
========================================================= */

function newDiary(){

    document.getElementById("diaryInputDate")
        .value=todayISO();

    document.getElementById("diaryInputTitle")
        .value="";

    document.getElementById("diaryInputText")
        .value="";

    document.getElementById("diaryInputMood")
        .value="😊";

    document
        .getElementById("diaryModal")
        .classList.add("show");

}


function saveDiary(){

    const diary={

        id:Date.now(),

        date:
            document.getElementById("diaryInputDate").value,

        title:
            document.getElementById("diaryInputTitle").value
            ||"Untitled Page",

        mood:
            document.getElementById("diaryInputMood").value,

        text:
            document.getElementById("diaryInputText").value

    };


    diaries.push(diary);

    diaries.sort((a,b)=>
        b.date.localeCompare(a.date)
    );


    currentDiaryIndex=0;

    saveAll();

    closeModal("diaryModal");

    renderDiary();

    renderHome();

    showToast("Diary page saved 📖");

}


function renderDiary(){

    if(!diaries.length){

        document.getElementById("diaryDate")
            .textContent="Your first page";

        document.getElementById("diaryTitle")
            .textContent="Welcome";

        document.getElementById("diaryText")
            .textContent=
            "Start writing your first story...";

        document.getElementById("diaryMood")
            .textContent="☁️";

        return;

    }


    const d=diaries[currentDiaryIndex];

    document.getElementById("diaryDate")
        .textContent=formatDate(d.date);

    document.getElementById("diaryTitle")
        .textContent=d.title;

    document.getElementById("diaryText")
        .textContent=d.text;

    document.getElementById("diaryMood")
        .textContent=d.mood;

    document.getElementById("leftPage")
        .textContent=currentDiaryIndex*2+1;

    document.getElementById("rightPage")
        .textContent=currentDiaryIndex*2+2;

}


function animateDiary(type){

    const spread=
        document.getElementById("diarySpread");

    spread.classList.remove(
        "page-turn-next",
        "page-turn-prev"
    );

    void spread.offsetWidth;

    spread.classList.add(
        type==="next"
        ?"page-turn-next"
        :"page-turn-prev"
    );

}


function nextDiary(){

    if(!diaries.length) return;

    if(currentDiaryIndex<
       diaries.length-1){

        currentDiaryIndex++;

        animateDiary("next");

        setTimeout(renderDiary,100);

    }

}


function previousDiary(){

    if(!diaries.length) return;

    if(currentDiaryIndex>0){

        currentDiaryIndex--;

        animateDiary("prev");

        setTimeout(renderDiary,100);

    }

}


function editCurrentDiary(){

    if(!diaries.length) return;

    const d=diaries[currentDiaryIndex];

    document.getElementById("diaryInputDate")
        .value=d.date;

    document.getElementById("diaryInputTitle")
        .value=d.title;

    document.getElementById("diaryInputMood")
        .value=d.mood;

    document.getElementById("diaryInputText")
        .value=d.text;


    document
        .getElementById("diaryModal")
        .classList.add("show");


    const oldSave=saveDiary;

}


function deleteCurrentDiary(){

    if(!diaries.length) return;

    if(!confirm("Delete this diary page?"))
        return;

    diaries.splice(
        currentDiaryIndex,
        1
    );

    currentDiaryIndex=
        Math.max(
            0,
            currentDiaryIndex-1
        );

    saveAll();

    renderDiary();

    renderHome();

}


/* =========================================================
   SCHEDULE
========================================================= */

function openEventModal(){

    document.getElementById("eventDate")
        .value=todayISO();

    document.getElementById("eventTime")
        .value="12:00";

    document.getElementById("eventTitle")
        .value="";


    document
        .getElementById("eventModal")
        .classList.add("show");

}


function saveEvent(){

    const event={

        id:Date.now(),

        title:
            document.getElementById("eventTitle").value
            ||"Untitled Event",

        date:
            document.getElementById("eventDate").value,

        time:
            document.getElementById("eventTime").value,

        category:
            document.getElementById("eventCategory").value

    };


    events.push(event);

    events.sort((a,b)=>
        (a.date+a.time)
        .localeCompare(
            b.date+b.time
        )
    );


    saveAll();

    closeModal("eventModal");

    renderEvents();

    renderCalendar();

    renderHome();

    showToast("Schedule added 📅");

}


function renderEvents(){

    const list=
        document.getElementById("eventList");

    if(!events.length){

        list.innerHTML=`
            <div class="card">
                <p class="muted">
                    No schedules yet.
                </p>
            </div>
        `;

        return;

    }


    list.innerHTML=
        events.map(e=>`

            <div class="event">

                <div class="event-row">

                    <div>

                        <h3>
                            ${escapeHTML(e.title)}
                        </h3>

                        <p class="muted">
                            ${escapeHTML(e.category)}
                        </p>

                    </div>

                    <div style="text-align:right">

                        <div class="event-time">
                            ${e.date}
                        </div>

                        <strong>
                            ${e.time}
                        </strong>

                    </div>

                </div>

                <br>

                <button
                    class="danger"
                    onclick="deleteEvent(${e.id})">
                    Delete
                </button>

            </div>

        `).join("");

}


function deleteEvent(id){

    events=
        events.filter(e=>e.id!==id);

    saveAll();

    renderEvents();

    renderCalendar();

    renderHome();

}


/* =========================================================
   NOTIFICATIONS
========================================================= */

async function enableNotifications(){

    if(!("Notification" in window)){

        showToast(
            "Your browser does not support notifications."
        );

        return;

    }


    const permission=
        await Notification.requestPermission();


    if(permission==="granted"){

        showToast(
            "Notifications enabled 🔔"
        );

        new Notification(
            "My Life Book",
            {
                body:
                    "Your schedule reminders are active ✦"
            }
        );

    }

}


function checkNotifications(){

    if(!("Notification" in window))
        return;

    if(Notification.permission!=="granted")
        return;


    const now=new Date();

    const date=
        now.toISOString().split("T")[0];

    const time=
        String(now.getHours()).padStart(2,"0")
        +":"
        +
        String(now.getMinutes()).padStart(2,"0");


    events.forEach(e=>{

        if(e.date!==date)
            return;

        if(e.time!==time)
            return;


        const key=
            e.id+"_"+date+"_"+time;


        if(notifiedEvents.includes(key))
            return;


        new Notification(
            "🔔 My Life Book Reminder",
            {
                body:
                    `${e.title} starts now!`
            }
        );


        showToast(
            `🔔 ${e.title} starts now!`
        );


        notifiedEvents.push(key);


        localStorage.setItem(
            "mlb_notified",
            JSON.stringify(notifiedEvents)
        );

    });

}


setInterval(
    checkNotifications,
    15000
);


/* =========================================================
   TASKS
========================================================= */

function addTask(){

    const input=
        document.getElementById("taskInput");

    const text=input.value.trim();

    if(!text) return;


    tasks.push({

        id:Date.now(),

        text,

        done:false

    });


    input.value="";

    saveAll();

    renderTasks();

    renderHome();

}


function renderTasks(){

    const list=
        document.getElementById("taskList");


    if(!tasks.length){

        list.innerHTML=`
            <div class="card">
                <p class="muted">
                    Your task list is empty ✦
                </p>
            </div>
        `;

        return;

    }


    list.innerHTML=
        tasks.map(t=>`

            <div class="card"
                 style="margin-bottom:10px">

                <div style="
                    display:flex;
                    justify-content:space-between;
                    align-items:center;
                    gap:10px;
                ">

                    <label style="
                        display:flex;
                        gap:10px;
                        align-items:center;
                    ">

                        <input
                            type="checkbox"
                            style="width:auto"
                            ${t.done?"checked":""}
                            onchange="toggleTask(${t.id})">

                        <span style="
                            ${t.done
                            ?"text-decoration:line-through;color:var(--muted)"
                            :""}
                        ">
                            ${escapeHTML(t.text)}
                        </span>

                    </label>


                    <button
                        class="danger"
                        onclick="deleteTask(${t.id})">
                        ×
                    </button>

                </div>

            </div>

        `).join("");

}


function toggleTask(id){

    const t=
        tasks.find(t=>t.id===id);

    if(t)
        t.done=!t.done;

    saveAll();

    renderTasks();

    renderHome();

}


function deleteTask(id){

    tasks=
        tasks.filter(t=>t.id!==id);

    saveAll();

    renderTasks();

    renderHome();

}


