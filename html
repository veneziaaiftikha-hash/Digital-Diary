function setTheme(name){

    const theme=themes[name];

    if(!theme)
        return;


    Object.entries(theme)
        .forEach(
            ([key,value])=>{

                document.documentElement
                    .style.setProperty(
                        "--"+key,
                        value
                    );

            }
        );


    localStorage.setItem(
        "mlb_theme",
        name
    );


    showToast(
        "Theme changed ✨"
    );

}


