function resizeSelected(amount){

    if(!selectedObject)
        return;


    if(
        selectedObject.classList
            .contains("collage-sticker")
    ){

        const current=
            parseFloat(
                getComputedStyle(
                    selectedObject
                ).fontSize
            );

        selectedObject.style.fontSize=
            Math.max(
                15,
                current+amount
            )+"px";

        return;

    }


    if(
        selectedObject.classList
            .contains("collage-photo")
    ){

        const width=
            selectedObject.offsetWidth
            +amount;

        selectedObject.style.width=
            Math.max(50,width)+"px";

        selectedObject.style.height=
            Math.max(50,width)+"px";

    }

}


function rotateSelected(deg){

    if(!selectedObject)
        return;


    let rotation=
        parseFloat(
            selectedObject.dataset.rotation
            ||"0"
        );


    rotation+=deg;


    selectedObject.dataset.rotation=
        rotation;


    selectedObject.style.transform=
        `rotate(${rotation}deg)`;

}


function deleteSelected(){

    if(!selectedObject)
        return;


    selectedObject.remove();

    selectedObject=null;

    document.getElementById(
        "selectionInfo"
    ).textContent=
        "Select an object.";

}


function moveLayer(direction){

    if(!selectedObject)
        return;


    const canvas=
        document.getElementById(
            "collageCanvas"
        );


    if(direction>0)
        canvas.appendChild(
            selectedObject
        );

    else
        canvas.insertBefore(
            selectedObject,
            canvas.firstChild
        );

}


