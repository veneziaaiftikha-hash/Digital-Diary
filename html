function selectObject(obj){

    if(selectedObject)
        selectedObject.classList.remove(
            "selected-object"
        );


    selectedObject=obj;


    if(obj){

        obj.classList.add(
            "selected-object"
        );

        document.getElementById(
            "selectionInfo"
        ).textContent=
            "Selected: "
            +
            (
                obj.dataset.type
                ||"object"
            );

    }

}


function makeDraggable(obj){

    let dragging=false;

    let offsetX=0;

    let offsetY=0;


    obj.addEventListener(
        "pointerdown",
        e=>{

            dragging=true;

            selectObject(obj);

            const rect=
                obj.getBoundingClientRect();

            offsetX=
                e.clientX-rect.left;

            offsetY=
                e.clientY-rect.top;

            obj.setPointerCapture(
                e.pointerId
            );

        }
    );


    obj.addEventListener(
        "pointermove",
        e=>{

            if(!dragging)
                return;


            const canvas=
                document.getElementById(
                    "collageCanvas"
                );

            const rect=
                canvas.getBoundingClientRect();


            let x=
                e.clientX
                -
                rect.left
                -
                offsetX;

            let y=
                e.clientY
                -
                rect.top
                -
                offsetY;


            x=Math.max(
                0,
                Math.min(
                    x,
                    canvas.clientWidth
                    -
                    obj.offsetWidth
                )
            );


            y=Math.max(
                0,
                Math.min(
                    y,
                    canvas.clientHeight
                    -
                    obj.offsetHeight
                )
            );


            obj.style.left=x+"px";

            obj.style.top=y+"px";

        }
    );


    obj.addEventListener(
        "pointerup",
        ()=>{
            dragging=false;
        }
    );

}


