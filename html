function applyTemplate(type){

    const canvas=
        document.getElementById(
            "collageCanvas"
        );


    const photos=
        [...canvas.querySelectorAll(
            ".collage-photo"
        )];


    if(!photos.length){

        showToast(
            "Upload some photos first 📷"
        );

        return;

    }


    photos.forEach(
        (photo,index)=>{

            photo.classList.remove(
                "polaroid"
            );


            photo.style.width="180px";

            photo.style.height="180px";

            photo.style.transform=
                "rotate(0deg)";


            if(type===2){

                photo.style.width="270px";

                photo.style.height="270px";

                photo.style.left=
                    index%2===0
                    ?"15px"
                    :"315px";

                photo.style.top="160px";

            }


            if(type===3){

                photo.style.width="180px";

                photo.style.height="180px";

                const positions=[

                    ["25px","200px"],

                    ["210px","80px"],

                    ["395px","200px"]

                ];

                if(positions[index]){

                    photo.style.left=
                        positions[index][0];

                    photo.style.top=
                        positions[index][1];

                }

            }


            if(type===4 || type==="grid"){

                photo.style.width="280px";

                photo.style.height="280px";


                const positions=[

                    ["10px","10px"],

                    ["310px","10px"],

                    ["10px","310px"],

                    ["310px","310px"]

                ];


                if(positions[index]){

                    photo.style.left=
                        positions[index][0];

                    photo.style.top=
                        positions[index][1];

                }

            }


            if(type==="polaroid"){

                photo.classList.add(
                    "polaroid"
                );

                photo.style.width="190px";

                photo.style.height="210px";


                photo.style.left=
                    (40+index*70)+"px";

                photo.style.top=
                    (150+(index%2)*50)+"px";


                photo.style.transform=
                    `rotate(${
                        index%2===0
                        ?-6
                        :6
                    }deg)`;

            }


            if(type==="free"){

                photo.style.width="160px";

                photo.style.height="160px";

                photo.style.left=
                    (50+index*45)+"px";

                photo.style.top=
                    (70+index*50)+"px";

            }

        }
    );

}


/* =========================================================
   EXPORT COLLAGE TO PNG
========================================================= */

async function exportCollage(){

    const canvas=
        document.getElementById(
            "collageCanvas"
        );


    /*
       We create a real PNG using an offscreen canvas.
       Images are loaded first so the result contains
       the actual photos.
    */


    const out=
        document.createElement("canvas");


    const scale=2;


    out.width=
        canvas.clientWidth*scale;

    out.height=
        canvas.clientHeight*scale;


    const ctx=
        out.getContext("2d");


    ctx.scale(scale,scale);


    const bg=
        getComputedStyle(
            canvas
        ).backgroundColor;


    ctx.fillStyle=
        bg==="rgba(0, 0, 0, 0)"
        ?"rgb(255,250,240)"
        :bg;


    ctx.fillRect(
        0,
        0,
        canvas.clientWidth,
        canvas.clientHeight
    );


    const objects=
        [...canvas.children];


    for(const obj of objects){

        const rect=
            obj.getBoundingClientRect();

        const canvasRect=
            canvas.getBoundingClientRect();


        const x=
            rect.left-canvasRect.left;

        const y=
            rect.top-canvasRect.top;


        ctx.save();


        const rotation=
            parseFloat(
                obj.dataset.rotation
                ||"0"
            )
            *
            Math.PI
            /
            180;


        const centerX=
            x+rect.width/2;

        const centerY=
            y+rect.height/2;


        ctx.translate(
            centerX,
            centerY
        );


        ctx.rotate(rotation);


        const w=
            rect.width;

        const h=
            rect.height;


        if(
            obj.tagName==="IMG"
        ){

            try{

                await drawImage(
                    ctx,
                    obj.src,
                    -w/2,
                    -h/2,
                    w,
                    h
                );

            }
            catch(err){

                console.log(err);

            }

        }

        else{

            const style=
                getComputedStyle(obj);


            ctx.font=
                `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;

            ctx.fillStyle=
                style.color
                ||
                "#3f3a35";


            ctx.textAlign="center";

            ctx.textBaseline="middle";


            ctx.fillText(
                obj.textContent,
                0,
                0
            );

        }


        ctx.restore();

    }


    const link=
        document.createElement("a");


    link.download=
        "my-life-book-collage.png";


    link.href=
        out.toDataURL("image/png");


    link.click();


    showToast(
        "Collage exported as PNG 🎨"
    );

}


function drawImage(
    ctx,
    src,
    x,
    y,
    w,
    h
){

    return new Promise(
        (resolve,reject)=>{

            const img=
                new Image();

            img.onload=()=>{

                ctx.drawImage(
                    img,
                    x,
                    y,
                    w,
                    h
                );

                resolve();

            };

            img.onerror=reject;

            img.src=src;

        }
    );

}


